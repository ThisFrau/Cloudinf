generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String           @id @default(cuid())
  username           String?          @unique
  email              String?          @unique
  emailVerified      DateTime?
  password           String?
  name               String?
  bio                String?
  avatarUrl          String?
  image              String?
  buttonStyle        String           @default("default")
  socialIconShape    String           @default("rounded")
  socialIconWidth    String           @default("normal")
  themeColor         String?
  layoutStyle           String           @default("list")
  avatarAlign           String           @default("center")
  bannerUrl             String?
  vcardEnabled          Boolean          @default(false)
  contactFormEnabled    Boolean          @default(false)
  contactFormAskName    Boolean          @default(true)
  contactFormAskEmail   Boolean          @default(true)
  contactFormAskPhone   Boolean          @default(false)
  contactFormAskMessage Boolean          @default(true)
  seoTitle           String?
  seoDescription     String?
  bgType             String           @default("default")
  bgColor            String?
  bgGradient1        String?
  bgGradient2        String?
  bgGradientDir      String?
  bgImageUrl         String?
  translateEnabled   Boolean          @default(false)
  spotifyProfileUrl  String?
  carouselEnabled    Boolean          @default(false)
  profileViews       Int              @default(0)

  // ── Estado temporal (Plus) ────────────────────────────────
  statusText         String?
  statusEmoji        String?
  statusExpiresAt    DateTime?

  // ── PDF / Catálogo descargable (Plus) ─────────────────────
  pdfCatalogUrl      String?
  pdfCatalogLabel    String?

  // ── Fuera de horario (Plus) ───────────────────────────────
  outOfOfficeEnabled Boolean          @default(false)
  outOfOfficeMsg     String?

  // ── AFIP / Facturación (Plus) ─────────────────────────────
  cuit               String?
  afipUrl            String?

  // ── Instagram (Plus/Premium) ──────────────────────────────
  instagramHandle    String?
  instagramFeedEnabled Boolean        @default(false)

  // ── QR Dinámico (Premium) ────────────────────────────────
  qrDynamicUrl       String?

  // ── Equipo (Premium) ─────────────────────────────────────
  teamEnabled        Boolean          @default(false)

  // ── Referidos (Plus) ─────────────────────────────────────
  referralCode       String?          @unique

  // ── Dashboard de agencia (Premium) ───────────────────────
  agencyToken        String?          @unique

  // ── Suscripción / Planes ──────────────────────────────────
  plan               String           @default("free") // "free" | "pro" | "team"
  planExpiresAt      DateTime?        // vencimiento del plan pago (null = sin vencimiento o free)
  nfcProBonusUntil   DateTime?        // bonus 2 meses Pro por activar tarjeta NFC
  teamProfileCount   Int              @default(6)      // solo relevante en plan "team"

  accounts           Account[]
  links              Link[]
  contactMessages    ContactMessage[]
  carouselPhotos     CarouselPhoto[]
  bookingConfig      BookingConfig?
  businessConfig     BusinessConfig?
  nfcCards           NfcCard[]
  scanLogs           ScanLog[]
  quoteForm          QuoteForm?
  campaign           Campaign?
  teamMembers        TeamMember[]
  referrals          Referral[]
  createdAt          DateTime         @default(now())
}


model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Link {
  id           String   @id @default(cuid())
  title        String
  url          String
  icon         String?
  platform     String
  displayStyle String   @default("auto")
  type         String   @default("link")
  customImage  String?
  clicks       Int      @default(0)
  order        Int      @default(0)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String?
  email     String?
  phone     String?
  message   String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model CarouselPhoto {
  id        String   @id @default(cuid())
  imageUrl  String
  caption   String?
  order     Int      @default(0)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model BookingConfig {
  id            String    @id @default(cuid())
  enabled       Boolean   @default(true)
  title         String    @default("Reserva una reunion")
  availableDays String    @default("[\"mon\",\"tue\",\"wed\",\"thu\",\"fri\"]")
  startTime     String    @default("09:00")
  endTime       String    @default("17:00")
  slotDuration  Int       @default(60)
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  createdAt     DateTime  @default(now())
}

model Booking {
  id        String        @id @default(cuid())
  name      String
  email     String
  date      String
  time      String
  note      String?
  status    String        @default("pending")
  configId  String
  config    BookingConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
}

model NfcCard {
  id        String    @id @default(cuid())
  token     String    @unique
  status    String    @default("unclaimed") // "unclaimed" | "claimed"
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  claimedAt DateTime?
  createdAt DateTime  @default(now())
}

model BusinessConfig {
  id               String   @id @default(cuid())
  enabled          Boolean  @default(false)
  businessName     String?
  type             String   @default("restaurant") // restaurant, bar, coffee, etc
  address          String?
  mapsUrl          String?
  hours            String?  // Formato texto libre
  phone            String?
  menuUrl          String?
  wifiName         String?
  wifiPassword     String?
  reservationsUrl  String?
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
}

// ── Historial de escaneos (Premium) ───────────────────────────────────────────
model ScanLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    String?  // "direct" | "qr" | "nfc"
  device    String?  // "mobile" | "desktop"
  createdAt DateTime @default(now())
}

// ── Formulario de presupuesto (Plus) ──────────────────────────────────────────
model QuoteForm {
  id          String            @id @default(cuid())
  enabled     Boolean           @default(false)
  title       String            @default("Pedí un presupuesto")
  description String?
  fields      String            @default("[]")
  userId      String            @unique
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions QuoteSubmission[]
  createdAt   DateTime          @default(now())
}

model QuoteSubmission {
  id        String    @id @default(cuid())
  formId    String
  form      QuoteForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  data      String
  name      String?
  email     String?
  createdAt DateTime  @default(now())
}

// ── Modo campaña (Premium) ────────────────────────────────────────────────────
model Campaign {
  id        String    @id @default(cuid())
  enabled   Boolean   @default(false)
  title     String?
  message   String?
  ctaLabel  String?
  ctaUrl    String?
  bannerUrl String?
  endsAt    DateTime?
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
}

// ── Perfiles de equipo (Premium) ──────────────────────────────────────────────
model TeamMember {
  id         String   @id @default(cuid())
  name       String
  role       String?
  avatarUrl  String?
  profileUrl String?
  order      Int      @default(0)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

// ── Cupones de descuento ──────────────────────────────────────────────────────
model Coupon {
  id          String        @id @default(cuid())
  code        String        @unique
  discountPct Int           // porcentaje (1–100)
  maxUses     Int?          // null = ilimitado
  usedCount   Int           @default(0)
  expiresAt   DateTime?     // null = sin vencimiento
  active      Boolean       @default(true)
  appliesTo   String        @default("all") // "nfc" | "subscription" | "all"
  description String?
  usages      CouponUsage[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String?  // null si el usuario no estaba logueado
  context   String   // "nfc" | "subscription"
  createdAt DateTime @default(now())
}

// ── Programa de referidos (Plus) ──────────────────────────────────────────────
model Referral {
  id            String   @id @default(cuid())
  referrerId    String
  referrer      User     @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  referredEmail String
  status        String   @default("pending") // pending | completed
  createdAt     DateTime @default(now())
}

